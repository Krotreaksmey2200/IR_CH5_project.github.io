   <string notr="true">
QMainWindow {
    background-color: #0d1117;
}
QWidget#centralwidget {
    background-color: #0d1117;
}
QLabel {
    color: #8b949e;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
}
QLabel#labelTitle {
    color: #58a6ff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 4px;
}
QLabel#labelSubtitle {
    color: #3d444d;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 3px;
}
QTextEdit {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #21262d;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 10px;
    selection-background-color: #1f6feb;
}
QTextEdit:focus {
    border: 1px solid #388bfd;
}
QPushButton#btnLoad {
    background-color: #21262d;
    color: #3fb950;
    border: 1px solid #3fb950;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 0px 16px;
}
QPushButton#btnLoad:hover {
    background-color: #3fb950;
    color: #0d1117;
}
QPushButton#btnLoad:pressed {
    background-color: #2ea043;
    color: #0d1117;
}
QPushButton#btnProcess {
    background-color: #21262d;
    color: #f78166;
    border: 1px solid #f78166;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 0px 16px;
}
QPushButton#btnProcess:hover {
    background-color: #f78166;
    color: #0d1117;
}
QPushButton#btnProcess:pressed {
    background-color: #e05c42;
    color: #0d1117;
}
QPushButton#btnChart {
    background-color: #21262d;
    color: #79c0ff;
    border: 1px solid #388bfd;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 0px 16px;
}
QPushButton#btnChart:hover {
    background-color: #388bfd;
    color: #0d1117;
}
QPushButton#btnChart:pressed {
    background-color: #1f6feb;
    color: #0d1117;
}
QFrame#divider {
    background-color: #21262d;
}
QFrame#headerFrame {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
    border-radius: 0px;
}
QFrame#statsFrame {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
}
QLabel#statValue {
    color: #58a6ff;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0px;
}
QLabel#statLabel {
    color: #3d444d;
    font-size: 10px;
    letter-spacing: 2px;
}
QScrollBar:vertical {
    background: #161b22;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #484f58;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
